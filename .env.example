# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Telegram ID глобального админа (узнать можно у @userinfobot)
ADMIN_ID=123456789

# База данных. По умолчанию SQLite-файл в папке data/.
# Для PostgreSQL: postgresql+asyncpg://user:password@host:5432/deadlinebot
DATABASE_URL=sqlite+aiosqlite:///data/deadlinebot.db

# При запуске приводить треки и разделы предметов к seed.yaml (true/false).
# Выключите, когда начнёте править треки через бота (/admin_tracks),
# иначе при перезапуске они перезапишутся из файла.
SEED_SYNC_TRACKS=true

# Сколько раз студент может сам изменить предметы после регистрации.
# Дальше — только через запрос администратору.
SUBJECT_CHANGE_LIMIT=2

# Часовой пояс, в котором студенты вводят и видят даты
TIMEZONE=Europe/Moscow

# LLM для распознавания дедлайнов из текста (этап 4)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Уровень логирования: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
